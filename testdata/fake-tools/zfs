#!/bin/sh
# Stand-in for the read-only zfs queries cbsd-web makes (dev and tests).
# web1 has three snapshots; build and db1 are clones of two of them.
last=""; for a in "$@"; do last=$a; done
case "$*" in
*"-t snapshot"*written*)
	printf '%s@base-install\t1758000000\t8388608\t1073741824\t1073741824\n' "$last"
	printf '%s@web20251001093000\t1759311000\t52428800\t209715200\t1299227607\n' "$last"
	printf '%s@before-upgrade\t1760983500\t104857600\t157286400\t1438814044\n' "$last" ;;
*"-t snapshot"*)
	printf '%s@web20251001093000\t52428800\n%s@before-upgrade\t104857600\n' "$last" "$last" ;;
get*)
	case "$last" in
	*/db1*) origin=zroot/jails/web1@base-install ;;
	*/build*) origin=zroot/jails/web1@web20251001093000 ;;
	*) origin=- ;;
	esac
	printf 'origin\t%s\nwritten\t31457280\nused\t1717986918\nreferenced\t1468006400\n' "$origin" ;;
*"-r -t filesystem"*)
	printf 'zroot\t-\t/zroot\nzroot/jails\t-\t/usr/jails\n'
	printf 'zroot/jails/web1\t-\t/usr/jails/jails-data/web1-data\n'
	printf 'zroot/jails/build-data\tzroot/jails/web1@web20251001093000\t/usr/jails/jails-data/build-data\n'
	printf 'zroot/jails/db1-data\tzroot/jails/web1@base-install\t/usr/jails/jails-data/db1-data\n' ;;
*)
	case "$last" in /*) ds="zroot/jails/$(basename "$last" | sed 's/-data$//')"; mp=$last ;; *) ds=$last; mp="/usr/jails/jails-data/$(basename "$last")-data" ;; esac
	printf '%s\t1288490188\t53687091200\t1181116006\t%s\n' "$ds" "$mp" ;;
esac
