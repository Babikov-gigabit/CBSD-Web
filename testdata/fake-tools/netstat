#!/bin/sh
# Stand-in for FreeBSD netstat -ibn; counters grow with time so rates show up.
t=$(date +%s); a=$(( (t % 100000) * 12345 )); b=$(( (t % 100000) * 2345 ))
cat <<X
Name      Mtu Network       Address              Ipkts Ierrs Idrop     Ibytes    Opkts Oerrs     Obytes  Coll
em0      1500 <Link#1>      08:00:27:aa:bb:cc   500000     0     0  700000000   400000     0   90000000     0
tap0     1500 <Link#5>      58:9c:fc:10:3c:7e     1200     0     0  $b     3400     0  $a     0
epair3a  1500 <Link#6>      02:a1:b2:c3:d4:0a      777     0     0  $a      999     0  $b     0
X
